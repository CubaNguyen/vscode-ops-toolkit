{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🐳 Docker: Logs: View service",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker logs ${input:service} -f --tail 200 | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Logs: View any (type name)",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker logs ${input:anycontainer} -f --tail 200 | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Logs: Last 2 hours",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker logs ${input:service} --since 2h | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Logs: Errors only",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker logs ${input:service} --tail 500 2>&1 | grep -a '@l' | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Logs: Search keyword",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker logs ${input:service} --tail 1000 2>&1 | python3 -u /tmp/logsearch.py ${input:keyword}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Service: Restart",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker restart ${input:service}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Service: Shell into container",
      "type": "shell",
      "command": "ssh",
      "args": [
        "-t",
        "YOUR_SERVER",
        "docker exec -it ${input:service} sh"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Server: CPU/RAM snapshot",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker stats --no-stream | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Server: CPU/RAM realtime",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker stats | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Server: Disk usage",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "df -h | python3 -u /tmp/dlog.py"
      ],
      "presentation": {
        "reveal": "always",
