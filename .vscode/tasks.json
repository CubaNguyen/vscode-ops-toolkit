    {
      "label": "🐳 Docker: Debug: Check all container status",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker ps -a --format 'table {{.Names}}\\t{{.Status}}\\t{{.RunningFor}}'"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🐳 Docker: Debug: Inspect container",
      "type": "shell",
      "command": "ssh",
      "args": [
        "YOUR_SERVER",
        "docker inspect ${input:anycontainer} | python3 /tmp/dinspect.py"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
